/usr/bin/bash -lc "mkdir -p /tmp/measure && cat > /tmp/measure/mkpng.py <<'EOF'
import struct, zlib, sys

def png(w, h, path):
    rows = b''.join(b'\\x00' + b'\\x30\\x60\\x90' * w for _ in range(h))
    def chunk(t, d):
        c = t + d
        return struct.pack('>I', len(d)) + c + struct.pack('>I', zlib.crc32(c) & 0xffffffff)
    sig = b'\\x89PNG\\r\\n\\x1a\\n'
    ihdr = struct.pack('>IIBBBBB', w, h, 8, 2, 0, 0, 0)
    out = sig + chunk(b'IHDR', ihdr) + chunk(b'IDAT', zlib.compress(rows, 6)) + chunk(b'IEND', b'')
    open(path, 'wb').write(out)

png(400, int(sys.argv[1]), sys.argv[2])
EOF
python3 /tmp/measure/mkpng.py 285 /tmp/measure/hero285.png && python3 /tmp/measure/mkpng.py 300 /tmp/measure/hero300.png && ls -l /tmp/measure" in /tmp/loopexp-iso3/codex-trap/work
