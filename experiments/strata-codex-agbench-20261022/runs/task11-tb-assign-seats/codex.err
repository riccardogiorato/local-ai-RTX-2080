import itertools
P = ['Alice','Bob','Charlie','David','Ethan','Frankie']
N=6
adj=lambda a,b:(a-b)%N in (1,N-1)
across=lambda a,b:(a-b)%N==3
def valid(pos, flip):
    A,B,D,E,F=pos['Alice'],pos['Bob'],pos['David'],pos['Ethan'],pos['Frankie']
    d = -1 if flip else 1
    if B "'!= (A + 2*d) % N: return False
    if adj(B,E): return False
    if across(E,B) and D != (A - 2*d) % N: return False
    if adj(A,F): return False
    if not (adj(F,D) or adj(F,E)): return False
    return True
for flip in (False,True):
    pairs=set()
    for perm in itertools.permutations(range(N)):
        pos=dict(zip(P,perm))
        if valid(pos,flip):
            n={v:k for k,v in pos.items()}; c=pos['"'Charlie']
            pairs.add(tuple(sorted([n[(c-1)%N],n[(c+1)%N]])))
    print(flip, sorted(pairs), len([1 for perm in itertools.permutations(range(N)) if valid(dict(zip(P,perm)),flip)]))
