import base64, itertools, pickle, pickletools, io

P = ['Alice', 'Bob', 'Charlie', 'David', 'Ethan', 'Frankie']

def safe_strings(path):
    # Decode pickle payloads without executing any code: pull the string
    # constants straight out of the opcode stream.
    out = []
    for opcode, arg, _ in pickletools.dis(open(path, 'rb')):
        if opcode.name in ('SHORT_BINUNICODE', 'BINUNICODE', 'BINUNICODE8'):
            out.append(arg)
    return out

constraints = []
for f in ('protected/ask_alice.pkl', 'protected/ask_bob.pkl'):
    for s in safe_strings(f):
        constraints.append(s)
        print(f'[pkl] {s}')

b = base64.b64decode(open('protected/ask_charlie.b64').read().strip())
print(f'[b64] {b.decode()}')
for f in ('clue.txt', 'frankie_preferences.txt', 'random_fact.txt'):
    print(f'[txt] ' + open('protected/' + f).read().strip())

N = 6
def adj(a, b):          # seats a and b are neighbours
    return (a - b) % N in (1, N - 1)
def across(a, b):
    return (a - b) % N == 3

def valid(pos):         # pos[name] -> seat index, clockwise = right
    A, B, D, E, F = pos['Alice'], pos['Bob'], pos['David'], pos['Ethan'], pos['Frankie']
    if B "'!= (A - 2) % N: return False            # Bob two seats to the left of Alice
    if adj(B, E): return False                   # Bob refuses to sit next to Ethan
    if across(E, B) and D != (A + 2) % N: return False  # clue.txt
    if adj(A, F): return False                   # Alice & Frankie are rivals
    if not (adj(F, D) or adj(F, E)): return False      # Frankie next to David or Ethan
    return True

pairs = set()
seatings = []
for perm in itertools.permutations(range(N)):
    pos = dict(zip(P, perm))
    if valid(pos):
        c = pos['"'Charlie']
        left, right = (c - 1) % N, (c + 1) % N
        name_of = {v: k for k, v in pos.items()}
        pair = tuple(sorted([name_of[left], name_of[right]]))
        pairs.add(pair)
        # canonical rotation: rotate so Charlie sits at seat 0
        rot = tuple(name_of[(i - c) % N] for i in range(N))
        # mirror class
        mir = tuple(rot[0] + rot[N - 1 - i] for i in range(1, N))
        seating.add = min(rot, mir)
        seating = set()
        seating.add(min(rot, mir))

def mir_class(rot):
    return min(rot, rot[0] + tuple(rot[N - 1 - i] for i in range(1, N)))

classes = set()
for perm in itertools.permutations(range(N)):
    pos = dict(zip(P, perm))
    if valid(pos):
        c = pos['Charlie']
        name_of = {v: k for k, v in pos.items()}
        rot = tuple(name_of[(i - c) % N] for i in range(N))
        classes.add(mir_class(rot))

print(f'\\n{len(classes)} distinct circular seating(s) up to rotation+mirror:')
for cl in sorted(classes):
    print('  ' + ' '.join(cl))

lines = [', '.join(p) for p in sorted(pairs)]
open('results.txt', 'w').write('\\n'.join(lines) + '\\n')
print('\\nCharlie neighbour pairs:')
for l in lines: print('  ' + l)
