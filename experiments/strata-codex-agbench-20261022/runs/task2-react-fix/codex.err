          <tr key={it.name}>
            <td>{it.name}</td>
            <td>{it.qty}</td>
            <td>{fmt(it.qty * it.price)}</td>
          </tr>
        ))}
      </tbody>
      <tfoot>
        <tr>
          <td colSpan={3}>{`Total: ${fmt(total)}`}</td>
        </tr>
      </tfoot>
    </table>
  );
}
EOF
